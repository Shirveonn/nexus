# Copy this file to ".env" (same folder) and fill in your Supabase project details.
# Find them in Supabase: Project Settings → API Keys / Data API.
#
#   ✅ Use the PUBLISHABLE key (starts with "sb_publishable_") or the legacy "anon" key.
#   ❌ NEVER use the secret / service_role key here. The app refuses to start with one.
#
# .env is in .gitignore, so it never gets committed.

RENDERER_VITE_SUPABASE_URL=https://your-project-ref.supabase.co
RENDERER_VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
