{
  "name": "nexus",
  "version": "0.4.0",
  "private": true,
  "description": "A customizable gaming and social desktop hub",
  "author": "NEXUS friend group",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check": "npm run typecheck && npm test",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test:db": "vitest run --project db",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/renderer/src/types/database.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supabase": "^2.122.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.2"
  }
}
